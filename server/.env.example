# Server-only. Copy to .env and fill in locally — never commit real values.

PORT=3001

# Supabase project settings -> API. Use the service_role key here (server-side
# only — this bypasses Row Level Security, so it must never reach the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Yoxa sends back as the X-API-Key header on every connector
# call. Generate your own — e.g. `openssl rand -hex 32` — and paste the same
# value into each connector's security config when you upload the YAML below.
CONNECTOR_API_KEY=

# Filled in later, at Release -> Integration, when the Yoxa trigger is wired up.
YOXA_TRIGGER_URL=
YOXA_DEPLOYMENT_SECRET=
